# Copy this file to .env (for Docker Compose) or .env.development (for local dev) and fill in your values

# Environment (development, staging, production)
APP_ENV=development

# Database Configurations
DB_ROOT_PASSWORD=rootpassword
DB_HOST=mysql
DB_PORT=3306
DB_USER=gowallet_user
DB_PASSWORD=gowallet_password
DB_NAME=gowallet
DB_NAME_DEFAULT=gowallet
DB_NAME_AUTH=gowallet_auth
DB_NAME_USER=gowallet_user
DB_NAME_WALLET=gowallet_wallet
DB_NAME_LEDGER=gowallet_ledger
DB_NAME_TRANSACTION=gowallet_transaction
DB_NAME_PAYMENT=gowallet_payment
DB_NAME_NOTIFICATION=gowallet_notification

# Redis Configurations
REDIS_HOST=redis
REDIS_PORT=6379
# Combined REDIS_ADDR for API Gateway rate limiter (defaults to REDIS_HOST:REDIS_PORT via config)
REDIS_ADDR=redis:6379

# Message Broker Configurations
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# MongoDB Configurations (audit-service)
MONGO_URL=mongodb://mongodb:27017
MONGO_PORT=27017

# SMTP / Email Configurations
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=no-reply@gowallet.com

# MinIO Configuration (Object Storage)
MINIO_PORT=9000
MINIO_WEB_PORT=9001
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PUBLIC_URL=http://localhost:9000
OUTBOX_ARCHIVE_AGE=24h

# Service Ports (HTTP)
GATEWAY_PORT=8080
AUTH_PORT=8081
WALLET_PORT=8082
PAYMENT_PORT=8083
USER_PORT=8084
LEDGER_PORT=8085
TRANSACTION_PORT=8086
MAILHOG_PORT=1025
MAILHOG_WEB_PORT=8025

# gRPC Ports
AUTH_GRPC_PORT=50051
WALLET_GRPC_PORT=50053
LEDGER_GRPC_PORT=50054
TRANSACTION_GRPC_PORT=50055
PAYMENT_GRPC_PORT=50056

# gRPC Addresses
# For Docker Compose use service names (e.g. auth-service:50051)
# For local dev use localhost (e.g. localhost:50051)
AUTH_GRPC_ADDR=auth-service:50051
USER_GRPC_ADDR=user-service:50052
WALLET_GRPC_ADDR=wallet-service:50053
LEDGER_GRPC_ADDR=ledger-service:50054
TRANSACTION_GRPC_ADDR=transaction-service:50055
PAYMENT_GRPC_ADDR=payment-service:50056

# JWT Configuration (at least 32 characters required in production)
JWT_SECRET=your-super-secret-jwt-key

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# Service URLs for API Gateway
# For Docker Compose use service names (e.g. http://auth-service:8081)
# For local dev use localhost (e.g. http://localhost:8081)
AUTH_SERVICE_URL=http://auth-service:8081
USER_SERVICE_URL=http://user-service:8084
WALLET_SERVICE_URL=http://wallet-service:8082
LEDGER_SERVICE_URL=http://ledger-service:8085
TRANSACTION_SERVICE_URL=http://transaction-service:8086
PAYMENT_SERVICE_URL=http://payment-service:8083

# Base URL for local development services
TRANSACTION_BASE_URL=http://localhost:8086

# Stripe Sandbox Configuration
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
WEBHOOK_SECRET_KEY=whsec_your_webhook_secret

# Base URL for redirect callbacks (Stripe success/cancel URLs)
BASE_URL=http://localhost:8080

# Monolith ewallet base URL (for cross-ewallet transfers)
# Use host.docker.internal when monolith runs on host outside Docker
MONOLITH_BASE_URL=http://host.docker.internal:8000

# Webhook shared secret for HMAC signature verification (shared between microservice & monolith)
WEBHOOK_SECRET=gowallet-webhook-secret-change-me

# Gateway callback URL (monolith calls back this URL after external transfer)
GATEWAY_CALLBACK_URL=http://host.docker.internal:8080

# Jaeger Configuration (Distributed Tracing)
JAEGER_UI_PORT=16686
JAEGER_GRPC_PORT=4317
JAEGER_HTTP_PORT=4318
# For Docker Compose use: OTEL_COLLECTOR_ADDR=jaeger:4317
# For local development use: OTEL_COLLECTOR_ADDR=localhost:4317
OTEL_COLLECTOR_ADDR=jaeger:4317

# WebSocket Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
WEBSOCKET_CHANNEL=websocket:notifications

# Monitoring Configuration (Prometheus & Grafana)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ELK Stack Configuration (Centralized Logging)
ELASTICSEARCH_PORT=9200
LOGSTASH_PORT=5000
KIBANA_PORT=5601
LOGSTASH_ADDR=logstash:5000

# SonarQube Configuration (Static Code Analysis)
SONARQUBE_PORT=9009

# Jenkins Configuration (CI/CD Pipeline)
JENKINS_PORT=8088
JENKINS_AGENT_PORT=50000

# ngrok Configuration (expose Jenkins to internet for webhook)
NGROK_PORT=4040
NGROK_AUTHTOKEN=your_ngrok_token_here
